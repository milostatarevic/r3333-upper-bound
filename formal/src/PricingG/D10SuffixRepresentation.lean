theorem fastWord_eq (i : Leaf) : fastWord i = matrixWord i := by
  fin_cases i <;> rfl

def fastTable (i : Leaf) (a b : Fin 15) : Fin 4 :=
  if a=b then 0 else Fin.castLE (by omega) (fastWord i (Fin.ofNat 105 (edgeIndex a b)))

def fastMatrix (i : Leaf) : EdgeColoring (Fin 15) (Fin 4) where
  color := fastTable i
  color_symm a b := by
    have h : fastTable i = matrixTable i := by funext a b; simp only [fastTable,matrixTable,fastWord_eq]
    rw [h]
    exact matrixTable_symmetric i a b

theorem fastMatrix_eq (i : Leaf) : fastMatrix i = matrix i := by
  ext a b
  simp only [fastMatrix,fastTable,matrix,matrixTable,fastWord_eq]

def suffix (i : Leaf) : Sat.Fmla :=
  foreignSupportUnitClauses 2 selectedPosition (coordinates i) ++
  matrixUnitClauses (coordinates i) (fastMatrix i)

theorem suffix_eq_original (i : Leaf) : suffix i =
    foreignSupportUnitClauses 2 selectedPosition (coordinates i) ++
    matrixUnitClauses (coordinates i) (matrix i) := by
  simp only [suffix,fastMatrix_eq]

#print axioms suffix_eq_original

end PricingG.D10NativeSuffixFast
