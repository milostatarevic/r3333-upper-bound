def rootColor (v : Vertex) : Color :=
 if v.val≤14 then 0 else if v.val≤29 then 1 else if v.val≤44 then 2 else 3

def leftVertex (v : Fin 15) : Vertex := ⟨15+v.val,by omega⟩
def rightVertex (v : Fin 15) : Vertex := ⟨30+v.val,by omega⟩
def markedVertex (v : Fin 16) : Vertex := ⟨45+v.val,by omega⟩

def matrixVertex (p : Pair) (a : Fin (shape p).dimension) : Vertex :=
 if hf:a.val<(shape p).free then ⟨a.val+1,by
   have h:(shape p).free≤5:=by cases shape p <;> decide
   omega⟩
 else if hl:a.val<(shape p).free+(shape p).left then
   leftVertex (leftOrder p ⟨a.val-(shape p).free,by omega⟩)
 else rightVertex (rightOrder p ⟨a.val-(shape p).free-(shape p).left,by have h:=Shape.dimension_sum (shape p);have ha:=a.isLt;omega⟩)

def member (p : Pair) (v : Vertex) : Bool :=
 if v.val=0 then true else if v.val≤(shape p).free then true else
 if v.val<15 then false else if v.val<30 then decide (v.val-15∈leftNats p)
 else if v.val<45 then decide (v.val-30∈rightNats p) else false

/-- Every asserted fact belongs to one full physical coloring. -/
structure SourceWitness (q : Bool) (p : Pair) (i : Fin 600) (c : Host) : Prop where
 good : NoMonochromaticTriangle c
 spokes : ∀v : Vertex,v≠0 → c 0 v=palette (rootColor v)
 left : ∀a b : Fin 15,a≠b → c (leftVertex a) (leftVertex b)=
   palette (PricingABD.ABGeometry.foreign 1 (R4333.k15Template false a b))
 right : ∀a b : Fin 15,a≠b → c (rightVertex a) (rightVertex b)=
   palette (PricingABD.ABGeometry.foreign 2 (R4333.k15Template false a b))
 marked : ∀a b : Fin 16,a≠b → c (markedVertex a) (markedVertex b)=
   palette (PricingABD.ABGeometry.foreign 3 (R4333.k16Template q a b))
 membership : ∀v : Vertex,v≠60 → (c v 60=palette 3 ↔ member p v=true)
 matrix : ∀a b : Fin (shape p).dimension,a≠b →
   c (matrixVertex p a) (matrixVertex p b)=
   palette (CompletionC.NativeMatrices.matrix (shape p) (candidate (shape p) i) a b)

