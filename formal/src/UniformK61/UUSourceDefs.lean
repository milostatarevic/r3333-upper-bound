def coordinate (p : Pair) (v : Vertex) : Option (Fin (shape p).dimension) :=
 let raw:=coordinateCodes[p.val]! / 16^v.val % 16
 if raw=0 then none else some ⟨(raw-1)%(shape p).dimension,Nat.mod_lt _ (Shape.dimension_positive (shape p))⟩

def CoordinateOK (p : Pair) (v : Vertex) : Prop :=
 match coordinate p v with
 | none => True
 | some a => matrixVertex p a=v
instance (p : Pair) (v : Vertex) : Decidable (CoordinateOK p v) := by
 unfold CoordinateOK;split <;> infer_instance
set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
theorem coordinate_ok : ∀p : Pair,∀v : Vertex,CoordinateOK p v := by decide +kernel

def fixedColor (q : Bool) (p : Pair) (i : Fin 600) (a b : Vertex) : Option Color :=
 if a=0 then some (rootColor b)
 else if 15≤a.val ∧ b.val<30 then some
  (PricingABD.ABGeometry.foreign 1 (R4333.k15Template false ⟨(a.val-15)%15,Nat.mod_lt _ (by decide)⟩ ⟨(b.val-15)%15,Nat.mod_lt _ (by decide)⟩))
 else if 30≤a.val ∧ b.val<45 then some
  (PricingABD.ABGeometry.foreign 2 (R4333.k15Template false ⟨(a.val-30)%15,Nat.mod_lt _ (by decide)⟩ ⟨(b.val-30)%15,Nat.mod_lt _ (by decide)⟩))
 else if 45≤a.val then some
  (PricingABD.ABGeometry.foreign 3 (R4333.k16Template q ⟨(a.val-45)%16,Nat.mod_lt _ (by decide)⟩ ⟨(b.val-45)%16,Nat.mod_lt _ (by decide)⟩))
 else match coordinate p a,coordinate p b with
 | some x,some y => if x=y then none else some
   (CompletionC.NativeMatrices.matrix (shape p) (candidate (shape p) i) x y)
 | _,_ => none

def sourceFact (q : Bool) (p : Pair) (i : Fin 600) (u : PhysicalUnit) : Bool :=
 let a:=min u.u u.v
 let b:=max u.u u.v
 decide (a<b) &&
 (if u.positive then
  (fixedColor q p i a b == some u.q) || (u.q==3 && b==60 && member p a)
 else u.q==3 && b==60 && !(member p a))

