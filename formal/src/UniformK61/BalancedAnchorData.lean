abbrev Chart := Fin 320
def chartRow (k : Chart) : CoverageRow := coverage[k.val]!
def chartKind (k : Chart) : Bool := (chartRow k).kind
def chartState (k : Chart) : Fin 6 := ⟨(chartRow k).state % 6,Nat.mod_lt _ (by decide)⟩
def chartOrder (k : Chart) (v : Fin 16) : Fin 16 :=
  ⟨(chartRow k).order.getD v.val 0 % 16,Nat.mod_lt _ (by decide)⟩
