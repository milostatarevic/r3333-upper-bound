def stateKinds : Array Bool := #[false, true, true, true, true, true]
def stateOrders : Array (Array Nat) := #[
  #[0, 2, 5, 6, 11, 8, 15, 13, 12, 14, 9, 1, 3, 4, 7, 10],
  #[0, 2, 6, 5, 11, 8, 12, 14, 15, 13, 9, 1, 3, 7, 4, 10],
