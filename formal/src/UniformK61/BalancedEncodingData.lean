]

def stateKind (s : Fin 6) : Bool := stateKinds[s.val]!
def stateOrder (s : Fin 6) (v : Fin 16) : Fin 16 :=
  ⟨(stateOrders[s.val]!.getD v.val 0) % 16, Nat.mod_lt _ (by decide)⟩
def stateColor (s : Fin 6) (a b : Fin 16) : Fin 3 :=
  R4333.k16Template (stateKind s) (stateOrder s a) (stateOrder s b)
def anchorPosition (a : Fin 5) : Fin 16 := ⟨a.val, by omega⟩
def memberPosition (a : Fin 11) : Fin 16 := ⟨5+a.val, by omega⟩

