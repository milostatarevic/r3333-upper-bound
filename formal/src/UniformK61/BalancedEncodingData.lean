def kindIndex (t : Bool) : Nat := if t then 1 else 0
def supportList (t : Bool) (i : Fin 16) : List (Fin 16) :=
  ((supportLists[kindIndex t]!)[i.val]!).toList.map (fun n => ⟨n % 16, Nat.mod_lt _ (by decide)⟩)
def support (t : Bool) (i : Fin 16) : Finset (Fin 16) := (supportList t i).toFinset
def anchor (t : Bool) (center : Fin 16) (a : Fin 5) : Fin 16 :=
  ⟨((anchorLists[kindIndex t]!)[center.val]!.getD a.val 0) % 16, Nat.mod_lt _ (by decide)⟩

