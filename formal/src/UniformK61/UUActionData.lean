 ⟨(if v.val=0 then 0 else if v.val≤5 then 1+freeDigit (row a).freeInverse (v.val-1)
 else if v.val≤14 then v.val else if v.val≤29 then
  (if (row a).swapped then 30 else 15)+(PricingC.U15SupportCover.autoMap (if (row a).swapped then (row a).rightInverse else (row a).leftInverse) ⟨(v.val-15)%15,Nat.mod_lt _ (by decide)⟩).val
 else if v.val≤44 then
  (if (row a).swapped then 15 else 30)+(PricingC.U15SupportCover.autoMap (if (row a).swapped then (row a).leftInverse else (row a).rightInverse) ⟨(v.val-30)%15,Nat.mod_lt _ (by decide)⟩).val
 else if (row a).swapped then 45+(qBackward q ⟨(v.val-45)%16,Nat.mod_lt _ (by decide)⟩).val else v.val)%61,Nat.mod_lt _ (by decide)⟩

