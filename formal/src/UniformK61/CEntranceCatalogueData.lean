def header (h : Fin 21) : Header := headers[h.val]!
def row (k : Fin 346) : Row := rows[k.val]!
def pair (k : Fin 346) : Fin 737 := (header (row k).header).pair
def five (k : Fin 346) : Bool := (header (row k).header).five
def leftType (k : Fin 346) : Bool := (header (row k).header).leftType
def rightType (k : Fin 346) : Bool := (header (row k).header).rightType
def caseId (k : Fin 346) : String := (row k).caseId

theorem rep_bound : ∀ k : Fin 346, (row k).repIndex < (pairTable (pair k)).count := by decide +kernel

def rep (k : Fin 346) : Fin (pairTable (pair k)).count := ⟨(row k).repIndex,rep_bound k⟩

