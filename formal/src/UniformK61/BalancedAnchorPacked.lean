def digit (code a : Nat) : Nat := (code >>> (4*a)) % 16
def color (code a b : Nat) : Nat := (code >>> (2*(16*a+b))) % 4
def edgesCheck (k : Chart) : Bool :=
  let order := orders[k.val]!
  let source := matrices[if chartKind k then 1 else 0]!
  let target := states[(chartState k).val]!
  (List.finRange 16).all fun a => (List.finRange 16).all fun b =>
    color source (digit order a.val) (digit order b.val) == color target a.val b.val

theorem edges_checks : (List.finRange 320).all edgesCheck=true := by decide +kernel
theorem literal_binding : ∀ (t : Bool) (a b : Fin 16),
  color matrices[if t then 1 else 0]! a.val b.val=(R4333.k16Template t a b).val := by decide +kernel
theorem orders_binding : ∀ (k : Chart) (v : Fin 16),
  digit orders[k.val]! v.val=(chartOrder k v).val := by decide +kernel
theorem states_binding : ∀ (k : Fin 6) (a b : Fin 16),
  color states[k.val]! a.val b.val=(stateColor k a b).val := by decide +kernel
theorem edges (k : Chart) (a b : Fin 16) :
  R4333.k16Template (chartKind k) (chartOrder k a) (chartOrder k b)=stateColor (chartState k) a b := by
  have hk := List.all_eq_true.mp edges_checks k (List.mem_finRange k)
  have ha := List.all_eq_true.mp hk a (List.mem_finRange a)
  have hb := List.all_eq_true.mp ha b (List.mem_finRange b)
  have h : color matrices[if chartKind k then 1 else 0]!
      (digit orders[k.val]! a.val) (digit orders[k.val]! b.val) =
      color states[(chartState k).val]! a.val b.val := by
    simpa only [beq_iff_eq] using hb
  rw [orders_binding,orders_binding,literal_binding,states_binding] at h
  exact Fin.ext h

#print axioms edges_checks
#print axioms literal_binding
end UniformK61.BalancedAnchor.Packed
