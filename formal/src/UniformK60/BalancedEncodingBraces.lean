def markedOrder (m : MarkChoice) (i : Fin 15) : Fin 15 :=
  if h : i.val=14 then markedPosition m else
    if hl : i.val<(markedPosition m).val then i else
      ⟨i.val+1,by omega⟩

def freeSize (r : Row) : Nat := (rowShape r).free

def vertex (n : Nat) : Vertex := ⟨n%60,Nat.mod_lt _ (by decide)⟩
def coord (n : Nat) : Fin 15 := ⟨n%15,Nat.mod_lt _ (by decide)⟩
def supportIndex (n : Nat) : Fin 5 := ⟨n%5,Nat.mod_lt _ (by decide)⟩

def rawSupport (r : Row) (i : Fin 15) : Vertex :=
  if i.val<freeSize r then vertex (1+i.val)
  else if i.val<freeSize r+5 then vertex (15+i.val-freeSize r)
  else vertex (29+(rowRealSupport r (supportIndex (i.val-freeSize r-5))).val)

def rawRootColor (v : Vertex) : Color :=
  if v.val≤14 then 0 else if v.val≤28 then 1 else if v.val≤44 then 2 else 3

def rawBrace (r : Row) (v : Vertex) : Bool :=
  decide (v=0 ∨ (1≤v.val ∧ v.val≤freeSize r) ∨ (15≤v.val ∧ v.val≤19) ∨
    ∃ j : Fin 5, j.val<(rowShape r).right ∧ v.val=29+(rowRealSupport r j).val)

def positiveUnit (u v : Vertex) (q : Color) : PhysicalUnit := ⟨true,u,v,q⟩
def crossUnit (r : Row) (code : Nat) : PhysicalUnit :=
  let a := coord (code%16)
  let b := coord (code/16)
  positiveUnit (rawSupport r a) (rawSupport r b) (rowMatrix r a b)

def rawRootUnits : List PhysicalUnit :=
  (((List.finRange 60).filter fun v => v≠0).map fun v => positiveUnit 0 v (rawRootColor v))

def rawRealUnits (r : Row) : List PhysicalUnit :=
  ((UniformK60.BalancedEncoding.pairs 16).map fun (a,b) =>
    positiveUnit (vertex (29+a.val)) (vertex (29+b.val))
      (UniformK60.PhysicalHelpers.foreign 2 (R4333.k16Template (rowKind r) a b)))

def rawMarkedUnits (m : MarkChoice) : List PhysicalUnit :=
  ((UniformK60.BalancedEncoding.pairs 15).map fun (a,b) =>
    positiveUnit (vertex (45+a.val)) (vertex (45+b.val))
      (UniformK60.PhysicalHelpers.foreign 3
        (R4333.k16Template (markedKind m) (markedOrder m a).castSucc (markedOrder m b).castSucc)))

def rawUnits (r : Row) (m : MarkChoice) : List PhysicalUnit :=
  rawRootUnits ++ rawRealUnits r ++ rawMarkedUnits m ++
  (((UniformK60.BalancedEncoding.pairs 5).filter fun (_,b) => b.val<freeSize r).map fun (a,b) =>
    positiveUnit (vertex (1+a.val)) (vertex (1+b.val)) (rowMatrix r (coord a.val) (coord b.val))) ++
  ((UniformK60.BalancedEncoding.pairs 5).map fun (a,b) =>
    positiveUnit (vertex (15+a.val)) (vertex (15+b.val))
      (rowMatrix r (coord (freeSize r+a.val)) (coord (freeSize r+b.val)))) ++
  (((crossOrders[r.val]!).toList).map (crossUnit r)) ++
  (((List.finRange 60).filter fun v => 1≤v.val ∧ v.val<59).map fun v =>
    ⟨rawBrace r v,59,v,3⟩)

def physicalColor : Color → Color := ![2,3,1,0]

def physicalVertex (r : Row) (m : MarkChoice) (v : Vertex) : Vertex :=
  if v.val=0 then 0 else if v.val≤28 then vertex (v.val+31)
  else if v.val≤44 then vertex (16+(cycle (rowKind r) ⟨(v.val-29)%16,Nat.mod_lt _ (by decide)⟩).val)
  else vertex (1+(cycle (markedKind m) (markedOrder m (coord (v.val-45))).castSucc).val)

def mappedUnit (r : Row) (m : MarkChoice) (u : PhysicalUnit) : PhysicalUnit :=
  ⟨u.positive,physicalVertex r m u.u,physicalVertex r m u.v,physicalColor u.q⟩

def units (c : Case) : List PhysicalUnit := (rawUnits c.1 c.2).map (mappedUnit c.1 c.2)
def owner (c : Case) : BalancedEncodingData.Owner := (markedKind c.2,rowKind c.1)
def formula (c : Case) : DenseCounter.CNF := BalancedEncodingData.formula (owner c) ++ unitsCNF (units c)

end UniformK60.BalancedEncodingBraces
