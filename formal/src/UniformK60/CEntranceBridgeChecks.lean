theorem checked (k : Index) : Valid (entry k) :=
  checked_batch ⟨k.val/32,by have := k.isLt;omega⟩ ⟨k.val%32,Nat.mod_lt _ (by decide)⟩

theorem lookup_chunk (mode : Mode) (b : Fin 8) (i : Fin 100)
    (h : Eligible mode (pairIndex b i)) (j : Fin (pairTable (pairIndex b i)).count) :
    Link mode (pairIndex b i) j := by
  fin_cases mode <;> fin_cases b
  · exact lookup_0_0 i h j
  · exact lookup_0_1 i h j
  · exact lookup_0_2 i h j
  · exact lookup_0_3 i h j
  · exact lookup_0_4 i h j
  · exact lookup_0_5 i h j
  · exact lookup_0_6 i h j
  · exact lookup_0_7 i h j
  · exact lookup_1_0 i h j
  · exact lookup_1_1 i h j
  · exact lookup_1_2 i h j
  · exact lookup_1_3 i h j
  · exact lookup_1_4 i h j
  · exact lookup_1_5 i h j
  · exact lookup_1_6 i h j
  · exact lookup_1_7 i h j
  · exact lookup_2_0 i h j
  · exact lookup_2_1 i h j
  · exact lookup_2_2 i h j
  · exact lookup_2_3 i h j
  · exact lookup_2_4 i h j
  · exact lookup_2_5 i h j
  · exact lookup_2_6 i h j
  · exact lookup_2_7 i h j

theorem lookup_complete (mode : Mode) (p : Fin 737) (h : Eligible mode p)
    (j : Fin (pairTable p).count) : Link mode p j := by
  let b : Fin 8 := ⟨p.val/100,by have := p.isLt;omega⟩
  let i : Fin 100 := ⟨p.val%100,Nat.mod_lt _ (by decide)⟩
  have he : pairIndex b i=p := by
    apply Fin.ext
    dsimp [pairIndex,b,i]
    omega
  have h' : Eligible mode (pairIndex b i) := by simpa only [he] using h
  have hall : ∀ k : Fin (pairTable p).count, Link mode p k :=
    Eq.mp (congrArg (fun q : Fin 737 =>
      ∀ k : Fin (pairTable q).count, Link mode q k) he)
      (lookup_chunk mode b i h')
  exact hall j

/-- Complete common A/B coverage reaches an already frozen entrance input. -/
theorem finite_bridge (mode : Mode) (p : Fin 737) (j : Fin (pairTable p).count)
    (h : Eligible mode p) :
    ∃ e : Entry, e.mode=mode ∧ e.pair=p ∧ e.repNat=j.val ∧ Valid e := by
  have hl := lookup_complete mode p h j
  exact ⟨entry (index mode p j),hl.1,hl.2.1,hl.2.2,checked _⟩

#print axioms finite_bridge
end UniformK60.CEntranceBridge
