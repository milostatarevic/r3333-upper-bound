def digit16 (code index : Nat) : Fin 16 := ⟨((code >>> (4*index)) &&& 15) % 16, Nat.mod_lt _ (by decide)⟩
def digit15 (code index : Nat) : Fin 15 := ⟨(digit16 code index).val % 15, Nat.mod_lt _ (by decide)⟩
def lookup (xs : Geometry → Array Nat) (g : Geometry) (i : Fin 600) : Nat := (xs g)[i.val]!
def target (g : Geometry) (i : Fin 600) : Row := ⟨lookup targetCodes g i % 60,Nat.mod_lt _ (by decide)⟩
def action (g : Geometry) (i : Fin 600) : Action := ⟨lookup actionCodes g i % 13,Nat.mod_lt _ (by decide)⟩
def forward (g : Geometry) (i : Fin 600) (a : Fin 15) : Fin 15 := digit15 (lookup forwardCodes g i) a.val
def inverse (g : Geometry) (i : Fin 600) (a : Fin 15) : Fin 15 := digit15 (lookup inverseCodes g i) a.val
def fullAction (a : Action) (v : Fin 16) : Fin 16 := digit16 (actionCode a) v.val

def geometryRealOrder (g : Geometry) (i : Fin 5) : Fin 16 := digit16 (geometryRealOrderCode g) i.val
def geometryRealSupport (g : Geometry) (i : Fin 5) : Fin 16 := digit16 (geometryRealSupportCode g) i.val
def rowRealSupport (r : Row) (i : Fin 5) : Fin 16 := digit16 (rowRealSupportCode r) i.val
def rowFakeSupport (r : Row) (i : Fin 5) : Fin 16 := digit16 (rowFakeSupportCode r) i.val

def fakeOrder : Fin 5 → Fin 16 := ![0,1,13,2,10]

def pairIndex (a b : Nat) : Nat := a*(29-a)/2+(b-a-1)
def rowMatrix (r : Row) (a b : Fin 15) : Fin 4 :=
  if a=b then 0 else
  let index := if a<b then pairIndex a.val b.val else pairIndex b.val a.val
  ⟨((rowMatrixCode r >>> (2*index)) &&& 3) % 4,Nat.mod_lt _ (by decide)⟩

/-- Which support group a live coordinate belongs to;3 denotes padding. -/
def group (s : Shape) (a : Fin 15) : Fin 4 :=
  if a.val<s.free then 0 else if a.val<s.free+5 then 1
  else if a.val<s.dimension then 2 else 3

end UniformK60.BalancedProjectedData
