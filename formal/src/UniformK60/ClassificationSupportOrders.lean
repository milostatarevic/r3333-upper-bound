theorem full_cycle : ∀ (t : Bool) (r : Fin 16) (q a : Fin 3), q ≠ a →
    R4333.colorDegree (R4333.k16Template t) q r = 5 →
    Function.Injective (fullCycleOrder t r q a) ∧
    univ.image (fullCycleOrder t r q a) = R4333.colorNeighborhood (R4333.k16Template t) q r ∧
    (∀ i j : Fin 5, i ≠ j →
      (R4333.k16Template t (fullCycleOrder t r q a i) (fullCycleOrder t r q a j) = a ↔
        CycleAdjacent i j)) := by
  decide +kernel

