set_option maxHeartbeats 5000000 in
theorem minor_path : ∀ (t : Bool) (r : Fin 15) (q a : Fin 3), q ≠ a →
    R4333.colorDegree (R4333.k15Template t) q r = 4 →
    Function.Injective (minorPathOrder t r q a) ∧
    univ.image (minorPathOrder t r q a) = R4333.colorNeighborhood (R4333.k15Template t) q r ∧
    (∀ i j : Fin 4, i ≠ j →
      (R4333.k15Template t (minorPathOrder t r q a i) (minorPathOrder t r q a j) = a ↔
        PathAdjacent i j)) := by
  decide +kernel

