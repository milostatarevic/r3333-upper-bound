def PathAdjacent (i j : Fin 4) : Prop := i.val + 1 = j.val ∨ j.val + 1 = i.val
instance (i j : Fin 4) : Decidable (PathAdjacent i j) := inferInstanceAs (Decidable (_ ∨ _))
def CycleAdjacent (i j : Fin 5) : Prop :=
  i.val + 1 = j.val ∨ j.val + 1 = i.val ∨
    (i.val = 0 ∧ j.val = 4) ∨ (j.val = 0 ∧ i.val = 4)
instance (i j : Fin 5) : Decidable (CycleAdjacent i j) := inferInstanceAs (Decidable (_ ∨ _ ∨ _ ∨ _))

