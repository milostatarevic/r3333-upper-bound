theorem minor_degrees : ∀ (t : Bool) (r : Fin 15) (q : Fin 3),
    R4333.colorDegree (R4333.k15Template t) q r = 4 ∨
      R4333.colorDegree (R4333.k15Template t) q r = 5 := by decide +kernel

