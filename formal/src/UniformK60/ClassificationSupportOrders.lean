set_option maxHeartbeats 5000000 in
theorem minor_cycle : ∀ (t : Bool) (r : Fin 15) (q a : Fin 3), q ≠ a →
    R4333.colorDegree (R4333.k15Template t) q r = 5 →
    Function.Injective (minorCycleOrder t r q a) ∧
    univ.image (minorCycleOrder t r q a) = R4333.colorNeighborhood (R4333.k15Template t) q r ∧
    (∀ i j : Fin 5, i ≠ j →
      (R4333.k15Template t (minorCycleOrder t r q a i) (minorCycleOrder t r q a j) = a ↔
        CycleAdjacent i j)) := by
  decide +kernel

