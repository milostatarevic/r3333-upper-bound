set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem plane_left : ∀ b c : Fin 16, Function.LeftInverse (planeMapInv b c) (planeMapFn b c) := by decide

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem plane_right : ∀ b c : Fin 16, Function.RightInverse (planeMapInv b c) (planeMapFn b c) := by decide

def planeMap (b c : Fin 16) : Fin 16 ≃ Fin 16 where
  toFun := planeMapFn b c
  invFun := planeMapInv b c
  left_inv := plane_left b c
  right_inv := plane_right b c

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem planeMap_graph (b c : Fin 16) : ∀ u v : Fin 16,
  xorGraph.Adj (planeMap b c u) (planeMap b c v) ↔ xorGraph.Adj u v := by
  fin_cases b <;> fin_cases c <;> decide

def QuadIndependent (a b c d : Fin 16) : Prop :=
  a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d ∧
  ¬xorGraph.Adj a b ∧ ¬xorGraph.Adj a c ∧ ¬xorGraph.Adj a d ∧
  ¬xorGraph.Adj b c ∧ ¬xorGraph.Adj b d ∧ ¬xorGraph.Adj c d

def QuadNonstar (a b c d : Fin 16) : Prop :=
  ∀ r : Fin 16, ¬(xorGraph.Adj r a ∧ xorGraph.Adj r b ∧ xorGraph.Adj r c ∧ xorGraph.Adj r d)

instance (a b c d : Fin 16) : Decidable (QuadIndependent a b c d) := inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _))

instance (a b c d : Fin 16) : Decidable (QuadNonstar a b c d) := inferInstanceAs (Decidable (∀ r : Fin 16, ¬(_ ∧ _ ∧ _ ∧ _)))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem nonstar_zero_coordinates (b c d : Fin 16) :
  QuadIndependent 0 b c d → QuadNonstar 0 b c d →
  planeMap b c 0 = 0 ∧ planeMap b c 3 = b ∧ planeMap b c 5 = c ∧ planeMap b c 6 = d := by
  revert d
  fin_cases b <;> fin_cases c <;> decide

#print axioms planeMap_graph
#print axioms nonstar_zero_coordinates
end PricingC.PlaneTables
