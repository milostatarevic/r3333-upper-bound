set_option maxRecDepth 10000 in
private theorem order_left : ∀ i : Fin 72, Function.LeftInverse (cycleOrderInv i) (cycleOrderFn i) := by decide

set_option maxRecDepth 10000 in
private theorem order_right : ∀ i : Fin 72, Function.RightInverse (cycleOrderInv i) (cycleOrderFn i) := by decide

def cycleOrder (i : Fin 72) : Fin 5 ≃ Fin 5 where
  toFun := cycleOrderFn i
  invFun := cycleOrderInv i
  left_inv := order_left i
  right_inv := order_right i

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem cycleOrder_color (i : Fin 72) : ∀ a b : Fin 5, a ≠ b →
    referenceColor i (generators (cycleOrder i a)) (generators (cycleOrder i b)) = cycleColor a b := by
  fin_cases i <;> decide

def anchoredIndex : Fin 6 → Fin 72 := ![5, 28, 39, 51, 56, 63]

def HasCycleAnchor (i : Fin 72) : Prop := ∀ a b : Fin 5, a ≠ b →
  referenceColor i (generators a) (generators b) = cycleColor a b

instance hasCycleAnchorDecidable (i : Fin 72) : Decidable (HasCycleAnchor i) := inferInstanceAs (Decidable (∀ a b : Fin 5, a ≠ b → _))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem anchored_exhaustive (i : Fin 72) : HasCycleAnchor i ↔ ∃ j : Fin 6, anchoredIndex j = i := by
  fin_cases i <;> decide

#print axioms cycleOrder_color
#print axioms anchored_exhaustive
end PricingC.AnchorTables
