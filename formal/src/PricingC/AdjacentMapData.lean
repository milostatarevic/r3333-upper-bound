set_option maxRecDepth 100000 in
private theorem left_inv : ∀ i : Fin 25, Function.LeftInverse (retainedInv i) (retainedMap i) := by decide

set_option maxRecDepth 100000 in
private theorem right_inv : ∀ i : Fin 25, Function.RightInverse (retainedInv i) (retainedMap i) := by decide

def retainedEquiv (i : Fin 25) : Fin 16 ≃ Fin 16 where
  toFun := retainedMap i
  invFun := retainedInv i
  left_inv := left_inv i
  right_inv := right_inv i

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem retained_graph (i : Fin 25) : ∀ u v : Fin 16,
  xorGraph.Adj (retainedEquiv i u) (retainedEquiv i v) ↔ xorGraph.Adj u v := by
  fin_cases i <;> decide

def retainedAuto (i : Fin 25) : xorGraph ≃g xorGraph where
  toEquiv := retainedEquiv i
  map_rel_iff' := retained_graph i _ _

set_option maxRecDepth 100000 in
theorem retained_adjacent : ∀ (i : Fin 25) (v : Fin 16), xorGraph.Adj v (retainedMap i v) := by decide

#print axioms retained_graph
end PricingC.AdjacentAutomorphisms
