def kind (r:Fin 98):Kind:=match kinds[r.val]! with
 | 0=>.u15 | 1=>.t15 | 2=>.u16 | _=>.t16
def size (r:Fin 98):Nat:=sizes[r.val]!
def autoIndex (r:Fin 98):Nat:=autoIndices[r.val]!
def digit (w i:Nat):Nat:=(w >>> (4*i)) &&& 15
def orderLabel (r:Fin 98) (i:Nat):Nat:=digit orderCodes[r.val]! i
def inducedLabel (r:Fin 98) (i:Nat):Nat:=digit inducedCodes[r.val]! i

def orderPositive (k:Kind):0<order k:=by cases k <;> decide
noncomputable def orderVertex (r:Fin 98) (i:Nat):Fin (order (kind r)):=
 ⟨orderLabel r i%order (kind r),Nat.mod_lt _ (orderPositive _)⟩
set_option maxHeartbeats 0
set_option maxRecDepth 1000000

theorem size_four_or_five : ∀r:Fin 98,size r=4 ∨ size r=5:=by decide +kernel
theorem order_injective : ∀r:Fin 98,∀i j:Fin 5,i.val<size r → j.val<size r →
 orderLabel r i.val=orderLabel r j.val → i=j:=by decide +kernel
theorem all_role_bounds : ∀r:Fin 98,∀i:Fin 5,i.val<size r →
 orderLabel r i.val<order (kind r) ∧ inducedLabel r i.val<size r:=by decide +kernel
theorem induced_injective : ∀r:Fin 98,∀i j:Fin 5,i.val<size r → j.val<size r →
 inducedLabel r i.val=inducedLabel r j.val → i=j:=by decide +kernel

/-- Exact original whole-template maps are bound to the previouslyproved
color-preserving automorphism pools, rather than newly assumed to bevalid. -/
theorem exact_whole_maps : ∀r:Fin 98,∀v:Fin 16,v.val<order (kind r) →
 (auto (kind r) (autoIndex r) ⟨v.val%order (kind r),Nat.mod_lt _ (orderPositive _)⟩).val=
 digit wholeCodes[r.val]! v.val:=by decide +kernel

/-- All98distinct original native support actions extend to the complete
physical15/16vertex template, with the originalcanonical supportorders. -/
theorem all_role_extensions : ∀r:Fin 98,∀i:Fin 5,i.val<size r →
 auto (kind r) (autoIndex r) (orderVertex r i.val)=orderVertex r (inducedLabel r i.val):=by decide +kernel

theorem physical_role_extension {V:Type} (r:Fin 98) (physical:Fin (order (kind r))↪V)
 (i:Fin 5) (hi:i.val<size r):
 reindex (kind r) (autoIndex r) physical (orderVertex r i.val)=
 physical (orderVertex r (inducedLabel r i.val)):=by
 change physical (auto (kind r) (autoIndex r) (orderVertex r i.val))=_
 rw[all_role_extensions r i hi]

#print axioms all_role_extensions
#print axioms physical_role_extension
end PricingC.NativeBlockActions
