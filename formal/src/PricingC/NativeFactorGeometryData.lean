def Good (g:Fin 1390):Prop:=FreeValid (nf g) (fc g) ∧
 (nf g+nl g+nr g=14 ∨ nf g+nl g+nr g=15) ∧
 ∀i:Fin 15,i.val<nf g+nl g+nr g → digit (code g) i.val=combined g i.val
instance (g:Fin 1390):Decidable (Good g):=inferInstanceAs (Decidable (_ ∧ _))
def Bind (f:Fin 27280):Prop:=
 freeSize f=nf (geometryOf f) ∧ size (left f)=nl (geometryOf f) ∧ size (right f)=nr (geometryOf f) ∧
 coordinateCode f=code (geometryOf f) ∧ freeCode f=fc (geometryOf f) ∧
 inducedCodes[(left f).val]! = lc (geometryOf f) ∧ inducedCodes[(right f).val]! = rc (geometryOf f)
instance (f:Fin 27280):Decidable (Bind f):=inferInstanceAs (Decidable (_ ∧ _))

end PricingC.NativeFactorGeometry
