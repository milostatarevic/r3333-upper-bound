set_option maxRecDepth 100000 in
private theorem norm_left : ∀ i, Function.LeftInverse (rootInverse i) (rootCoordinates i) := by decide

set_option maxRecDepth 100000 in
private theorem norm_right : ∀ i, Function.RightInverse (rootInverse i) (rootCoordinates i) := by decide

def rootEquiv (i : Fin 72) : Fin 16 ≃ Fin 16 where
  toFun := rootCoordinates i
  invFun := rootInverse i
  left_inv := norm_left i
  right_inv := norm_right i

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem roots_normalized (i : Fin 72) : ∀ u v : Fin 16,
  referenceColor i (rootEquiv i u) (rootEquiv i v) = referenceColor (rootRow (rootKind i)) u v := by
  fin_cases i <;> decide

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem root_graph (i : Fin 72) : ∀ u v : Fin 16,
  xorGraph.Adj (rootEquiv i u) (rootEquiv i v) ↔ xorGraph.Adj u v := by
  fin_cases i <;> decide

def rootAuto (i : Fin 72) : xorGraph ≃g xorGraph where
  toEquiv := rootEquiv i
  map_rel_iff' := root_graph i _ _

#print axioms roots_normalized
end PricingC.GIsomorphic
