def row (i : Fin 36) : Row := rowData[i.val]!
def original (i : Fin 36) : List Entry := originalData[i.val]!
def retained (i : Fin 737) : Record := retainedData[i.val]!
def naturalSet {n : Nat} (s : Finset (Fin n)) : Finset Nat := s.image Fin.val

def reps (kind : Nat) (four : Bool) : List (Finset Nat) :=
 match kind with
 | 0 => (if four then PricingC.U15SupportCover.representatives4 else PricingC.U15SupportCover.representatives5).map naturalSet
 | 1 => (if four then PricingABD.FiniteSupportsFast.representatives4 else PricingABD.FiniteSupportsFast.representatives5).map naturalSet
 | 2 => (if four then PricingC.U16SupportCover.representatives4 else PricingC.U16SupportCover.representatives5).map naturalSet
 | _ => (if four then PricingABD.T16SupportCover.representatives4 else PricingABD.T16SupportCover.representatives5).map naturalSet

def expected (i : Fin 36) : List (Finset Nat × Finset Nat) :=
 (reps (row i).leftKind ((row i).stage==1)).flatMap fun a =>
 (reps (row i).rightKind ((row i).stage==2)).map fun b => (a,b)
def source (i : Fin 36) (e : Entry) : Record :=
 ⟨(row i).family,(row i).leftKind,(row i).rightKind,(row i).stage,e.left,e.right⟩
def exchange (r : Record) : Record :=
 ⟨r.family,r.rightKind,r.leftKind,if r.stage=1 then 2 else if r.stage=2 then 1 else r.stage,r.right,r.left⟩
def EntryOK (i : Fin 36) (e : Entry) : Prop :=
 e.target<737 ∧ (if e.swapped then
  (row i).family=2 ∧ (row i).leftKind=1 ∧ (row i).rightKind=1 ∧ retainedData[e.target]! = exchange (source i e)
 else retainedData[e.target]! = source i e)
instance (i : Fin 36) (e : Entry) : Decidable (EntryOK i e) := inferInstanceAs (Decidable (_ ∧ _))
def RowOK (i : Fin 36) : Prop :=
 ((original i).map fun e => (e.left,e.right)).toFinset=(expected i).toFinset ∧
 ∀e∈original i,EntryOK i e
instance (i : Fin 36) : Decidable (RowOK i) := inferInstanceAs (Decidable (_ ∧ _))

theorem naturalSet_injective {n : Nat} : Function.Injective (naturalSet (n:=n)) := by
 intro a b h
 apply Finset.ext
 intro x
 constructor
 · intro hx
   have hh : x.val∈naturalSet b := by rw[←h];exact mem_image.mpr ⟨x,hx,rfl⟩
   obtain ⟨y,hy,he⟩ := mem_image.mp hh
   simpa only [Fin.ext he] using hy
 · intro hx
   have hh : x.val∈naturalSet a := by rw[h];exact mem_image.mpr ⟨x,hx,rfl⟩
   obtain ⟨y,hy,he⟩ := mem_image.mp hh
   simpa only [Fin.ext he] using hy
end PricingIntegration.PairAdmission
