private theorem decomp_left : ∀ d : Fin 72, Function.LeftInverse (decompInv d) (decompMap d) := by decide +kernel
private theorem decomp_right : ∀ d : Fin 72, Function.RightInverse (decompInv d) (decompMap d) := by decide +kernel

def decompEquiv (d : Fin 72) : Fin 16 ≃ Fin 16 :=
  ⟨decompMap d,decompInv d,decomp_left d,decomp_right d⟩

def nativeColor (i : Fin 72) := referenceColor (censusRow i)
def rootColor (k : Fin 2) := referenceColor (rootRow k)

theorem decomp_graph : ∀ (d : Fin 72) (u v : Fin 16),
    nativeColor d (decompEquiv d u) (decompEquiv d v) = 1 ↔ xorGraph.Adj u v := by decide +kernel

def xVertex (a : Fin 16) : Fin 33 := ⟨a.val+1,by omega⟩
def yVertex (a : Fin 16) : Fin 33 := ⟨a.val+17,by omega⟩

def view (v : Fin 33) : Option (Bool × Fin 16) :=
  if h0 : v.val = 0 then none
  else if h16 : v.val ≤ 16 then some (false,⟨v.val-1,by omega⟩)
  else some (true,⟨v.val-17,by omega⟩)

theorem view_x : ∀ a : Fin 16, view (xVertex a) = some (false,a) := by decide
theorem view_y : ∀ a : Fin 16, view (yVertex a) = some (true,a) := by decide
theorem view_root : view 0 = none := by decide

def xColors : Fin 3 → Color := ![1,2,3]
def yColors : Fin 3 → Color := ![0,2,3]

def cross (d : Fin 72) (x y : Fin 16) : Option Color :=
  if xorGraph.Adj x y then some 1
  else if nativeColor d x y = 1 then some 0
  else none

def base (kind : Fin 2) (d y : Fin 72) (u v : Fin 33) : Option Color :=
  if u = v then none else
  match view u,view v with
  | none,none => none
  | none,some (side,_) => some (if side then 1 else 0)
  | some (side,_),none => some (if side then 1 else 0)
  | some (false,a),some (false,b) => some (xColors (rootColor kind a b))
  | some (true,a),some (true,b) => some (yColors (nativeColor y ((decompEquiv d).symm a) ((decompEquiv d).symm b)))
  | some (false,a),some (true,b) => cross d a b
  | some (true,a),some (false,b) => cross d b a

#print axioms decomp_graph
