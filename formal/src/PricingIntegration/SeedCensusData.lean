def anchorSource (p : Boundary) := anchorSourceIndex (index p)

def retainedB (p : Boundary) : List (Fin 16) := ((List.finRange 5).map (bRoles (pair p))).filter (fun a => some a != omitted p)
def retainedD (p : Boundary) : List (Fin 16) := ((List.finRange 5).map (dRoles (pair p))).filter (fun a => some a != omitted p)
def canonicalSMap (p : Boundary) (a : Fin 16) : Option Vertex :=
  if a = 0 then some 0
  else if some a = omitted p then none
  else if a ∈ (List.finRange 5).map PricingC.generators then some ⟨a.val+1,by omega⟩
  else if a ∈ retainedB p then some ⟨(17+(retainedB p).idxOf a)%61,by omega⟩
  else some ⟨(47+(retainedD p).idxOf a)%61,by omega⟩

def canonicalColor (p : Boundary) (a b : Fin 5) : Color :=
  if a.val+1=b.val ∨ b.val+1=a.val ∨ (size p=5 ∧ ((a=0 ∧ b=4) ∨ (a=4 ∧ b=0))) then 0 else 3

