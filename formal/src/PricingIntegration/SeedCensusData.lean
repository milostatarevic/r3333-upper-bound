abbrev Boundary := (Fin 6 × Fin 6) ⊕ ((Fin 6 × Fin 5 × Fin 6) ⊕ ((Fin 6 × Fin 5 × Fin 6) ⊕ (Fin 6 × Fin 5 × Fin 2)))

def bRoles : Fin 6 → Fin 5 → Fin 16 := ![![6,9,12,13,14],![5,6,7,10,14],![3,6,7,12,14],![3,6,7,9,11],![6,9,12,13,14],![3,6,7,12,14]]
def dRoles : Fin 6 → Fin 5 → Fin 16 := ![![3,5,7,10,11],![3,9,11,12,13],![5,9,10,11,13],![5,10,12,13,14],![3,5,7,10,11],![5,9,10,11,13]]
def planeIndex : Fin 2 → Fin 72 := ![39,46]

def index : Boundary → Fin 456
  | .inl (p,y) => ⟨p.val*6+y.val,by omega⟩
  | .inr (.inl (p,d,y)) => ⟨36+p.val*30+d.val*6+y.val,by omega⟩
  | .inr (.inr (.inl (p,b,y))) => ⟨216+p.val*30+b.val*6+y.val,by omega⟩
  | .inr (.inr (.inr (p,b,y))) => ⟨396+p.val*10+b.val*2+y.val,by omega⟩

def pair : Boundary → Fin 6
  | .inl (p,_) => p
  | .inr (.inl (p,_,_)) => p
  | .inr (.inr (.inl (p,_,_))) => p
  | .inr (.inr (.inr (p,_,_))) => p

def yState : Boundary → Fin 72
  | .inl (_,y) => anchoredIndex y
  | .inr (.inl (_,_,y)) => anchoredIndex y
  | .inr (.inr (.inl (_,_,y))) => anchoredIndex y
  | .inr (.inr (.inr (_,_,y))) => planeIndex y

def omitted : Boundary → Option (Fin 16)
  | .inl _ => none
  | .inr (.inl (p,d,_)) => some (dRoles p d)
  | .inr (.inr (.inl (p,b,_))) => some (bRoles p b)
  | .inr (.inr (.inr (p,b,_))) => some (bRoles p b)

def size : Boundary → Nat
  | .inl _ => 5
  | .inr (.inl _) => 5
  | _ => 4

def yRole (p : Boundary) : Fin 5 → Fin 16 :=
  match p with
  | .inr (.inr (.inr _)) => ![0,3,5,6,0]
  | _ => PricingC.generators

def isStar : Boundary → Bool
  | .inr (.inr (.inl _)) => true
  | _ => false

