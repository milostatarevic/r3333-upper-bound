private theorem finite_order : ∀ (profile : Fin 3) (a b c d : Fin 5),
    (12+a.val)+(12+b.val)+(12+c.val)+(12+d.val)=60 →
    mass4 (12+a.val) (12+b.val) (12+c.val) (12+d.val)=mass profile →
    ∀ q : Color, (![12+a.val,12+b.val,12+c.val,12+d.val] : Color → Nat)
      (permMap (orderCode a b c d) q)=shape profile q := by decide +kernel

 theorem degree_order (profile : Fin 3) (d : Color → Nat) (hb : ∀ q,d q≤16)
    (hs : d 0+d 1+d 2+d 3=60) (hm : mass4 (d 0) (d 1) (d 2) (d 3)=mass profile) :
    ∃ e : Color ≃ Color,∀ q,d (e q)=shape profile q := by
  have h0 := hb 0
  have h1 := hb 1
  have h2 := hb 2
  have h3 := hb 3
  have l0 : 12≤d 0 := by omega
  have l1 : 12≤d 1 := by omega
  have l2 : 12≤d 2 := by omega
  have l3 : 12≤d 3 := by omega
  let a : Fin 5 := ⟨d 0-12,by omega⟩
  let b : Fin 5 := ⟨d 1-12,by omega⟩
  let f : Fin 5 := ⟨d 2-12,by omega⟩
  let g : Fin 5 := ⟨d 3-12,by omega⟩
  have ha : 12+a.val=d 0 := by dsimp [a];omega
  have hb' : 12+b.val=d 1 := by dsimp [b];omega
  have hf : 12+f.val=d 2 := by dsimp [f];omega
  have hg : 12+g.val=d 3 := by dsimp [g];omega
  have he := finite_order profile a b f g (by simpa only [ha,hb',hf,hg] using hs) (by simpa only [ha,hb',hf,hg] using hm)
  have hd : (![d 0,d 1,d 2,d 3] : Color → Nat)=d := by funext q;fin_cases q <;> rfl
  refine ⟨permEquiv (orderCode a b f g),?_⟩
  intro q
  change d (permMap (orderCode a b f g) q)=_
  simpa only [ha,hb',hf,hg,hd] using he q

noncomputable def paletteEquiv : Color ≃ FourColor := Equiv.ofBijective palette
  ⟨palette_injective,palette_surjective⟩

/-- A single global palette permutation orders the actual supplied root;
neither the root nor any vertex or highness statistic is changed. -/
theorem actual_ABD_root_ordered (profile : Fin 3) (c : Host)
    (hc : NoMonochromaticTriangle c) (r : Vertex) (hw : W c r = mass profile) :
    ∃ σ : FourColor ≃ FourColor,
      NoMonochromaticTriangle (relabel c (Equiv.refl _) σ) ∧
      (∀ q : Color,colorDegree (relabel c (Equiv.refl _) σ) (palette q) r = shape profile q) ∧
      H (relabel c (Equiv.refl _) σ) r = H c r := by
  let d : Color → Nat := fun q => colorDegree c (palette q) r
  have hsum : d 0+d 1+d 2+d 3=60 := by
    simpa [d,palette,FourColor,Fintype.sum_prod_type,Nat.add_assoc] using fourColor_degree_sum c r
  have hm : mass4 (d 0) (d 1) (d 2) (d 3)=mass profile := by
    exact (W_eq_mass4 c r).symm.trans hw
  obtain ⟨e,he⟩ := degree_order profile d (fun q => fourColor_colorDegree_le_sixteen c hc _ _) hsum hm
  let σ := paletteEquiv.symm.trans (e.trans paletteEquiv)
  refine ⟨σ,relabel_noMono c hc _ _,?_,relabel_H c _ _ r⟩
  intro q
  rw [relabel_degree]
  have hp : σ (palette q) = palette (e q) := by
    change paletteEquiv (e (paletteEquiv.symm (paletteEquiv q))) = _
    rw [Equiv.symm_apply_apply]
    rfl
  simpa only [hp,Equiv.refl_apply] using he q

#print axioms degree_order
#print axioms actual_ABD_root_ordered
