def edgeIndex (left right : Fin 15) : Nat :=
  let lo := min left.val right.val
  let hi := max left.val right.val
  lo * (29 - lo) / 2 + (hi - lo - 1)

theorem edgeIndex_symm (left right : Fin 15) :
    edgeIndex left right = edgeIndex right left := by
  simp [edgeIndex, min_comm, max_comm]

def matrixTable (leaf : Leaf) (left right : Fin 15) : Fin 4 :=
  if left = right then 0
  else Fin.castLE (by omega) (matrixWord leaf (Fin.ofNat 105 (edgeIndex left right)))

theorem matrixTable_symmetric (leaf : Leaf) (left right : Fin 15) :
    matrixTable leaf left right = matrixTable leaf right left := by
  by_cases h : left = right
  · subst right
    simp [matrixTable]
  · have h' : right ≠ left := Ne.symm h
    simp [matrixTable, h, h', edgeIndex_symm]

def matrix (leaf : Leaf) : EdgeColoring (Fin 15) (Fin 4) where
  color := matrixTable leaf
  color_symm := matrixTable_symmetric leaf

theorem matrix_diagonal_zero (leaf : Leaf) (vertex : Fin 15) :
    matrix leaf vertex vertex = 0 := by
  simp [matrix, matrixTable]

theorem matrix_avoids_three (leaf : Leaf) (left right : Fin 15) :
    matrix leaf left right ≠ 3 := by
  change matrixTable leaf left right ≠ 3
  unfold matrixTable
  split
  · decide
  · intro h
    have hval := congrArg Fin.val h
    have hlt := (matrixWord leaf (Fin.ofNat 105 (edgeIndex left right))).isLt
    simp only [Fin.val_castLE] at hval
    omega

