/-! ## Ordered support coordinates -/

def supportEmbedding : SupportRepresentative → FiveVertex ↪ Fin 15
  | .s0 => {
      toFun := ![0, 1, 2, 10, 13]
      inj' := by decide }
  | .s1 => {
      toFun := ![0, 1, 3, 11, 12]
      inj' := by decide }
  | .s4 => {
      toFun := ![1, 6, 9, 10, 11]
      inj' := by decide }

def support (representative : SupportRepresentative) : OrderedFiveSupport 15 where
  embedding := supportEmbedding representative
  ascending := by
    cases representative <;> simp [supportEmbedding] <;> decide

theorem support_positions :
    (support .s0).positions = {0, 1, 2, 10, 13} ∧
    (support .s1).positions = {0, 1, 3, 11, 12} ∧
    (support .s4).positions = {1, 6, 9, 10, 11} := by
  constructor
  · ext x
    fin_cases x <;> decide
  constructor <;> ext x <;> fin_cases x <;> decide

def matrixVertexEmbedding :
    SupportRepresentative → SupportRepresentative → Fin 15 ↪ TotalVertex
  | .s0, .s0 =>
      { toFun := ![0, 1, 2, 3, 4, 5, 6, 7, 15, 18, 20, 21, 22, 30, 33]
        inj' := by decide }
  | .s0, .s1 =>
      { toFun := ![0, 1, 2, 3, 4, 5, 6, 7, 15, 18, 20, 21, 23, 31, 32]
        inj' := by decide }
  | .s0, .s4 =>
      { toFun := ![0, 1, 2, 3, 4, 5, 6, 7, 15, 18, 21, 26, 29, 30, 31]
        inj' := by decide }
  | .s1, .s0 =>
      { toFun := ![0, 1, 2, 3, 4, 5, 6, 8, 16, 17, 20, 21, 22, 30, 33]
        inj' := by decide }
  | .s1, .s1 =>
      { toFun := ![0, 1, 2, 3, 4, 5, 6, 8, 16, 17, 20, 21, 23, 31, 32]
        inj' := by decide }
  | .s1, .s4 =>
      { toFun := ![0, 1, 2, 3, 4, 5, 6, 8, 16, 17, 21, 26, 29, 30, 31]
        inj' := by decide }
  | .s4, .s0 =>
      { toFun := ![0, 1, 2, 3, 4, 6, 11, 14, 15, 16, 20, 21, 22, 30, 33]
        inj' := by decide }
  | .s4, .s1 =>
      { toFun := ![0, 1, 2, 3, 4, 6, 11, 14, 15, 16, 20, 21, 23, 31, 32]
        inj' := by decide }
  | .s4, .s4 =>
      { toFun := ![0, 1, 2, 3, 4, 6, 11, 14, 15, 16, 21, 26, 29, 30, 31]
        inj' := by decide }

def coordinatesFor (first second : SupportRepresentative) :
    MatrixCoordinates 2 where
  first := support first
  second := support second
  vertex := matrixVertexEmbedding first second
  vertex_free := by
    cases first <;> cases second <;> intro a <;> fin_cases a <;>
      simp [matrixVertexEmbedding, freeMatrixIndex, freeVertex]
  vertex_first := by
    cases first <;> cases second <;> intro a <;> fin_cases a <;>
      simp [matrixVertexEmbedding, firstForeignMatrixIndex, support,
        supportEmbedding, firstForeignBlock, blockVertex, tailVertex,
        blockStart] <;> rfl
  vertex_second := by
    cases first <;> cases second <;> intro a <;> fin_cases a <;>
      simp [matrixVertexEmbedding, secondForeignMatrixIndex, support,
        supportEmbedding, secondForeignBlock, blockVertex, tailVertex,
        blockStart] <;> rfl

def coordinates (leaf : Leaf) : MatrixCoordinates 2 :=
  coordinatesFor (pairFirst (pairIndex leaf)) (pairSecond (pairIndex leaf))

