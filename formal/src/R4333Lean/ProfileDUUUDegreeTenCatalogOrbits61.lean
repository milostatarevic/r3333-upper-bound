def representativeIndex (kind : SupportKind) (i : Fin 600) : Fin 600 :=
  Fin.ofNat 600 (normalizerWord kind i % 600)

def freeActionIndex (kind : SupportKind) (i : Fin 600) : Fin 10 :=
  Fin.ofNat 10 ((normalizerWord kind i / 600) % 10)

def u15ActionIndex (kind : SupportKind) (i : Fin 600) : Fin 10 :=
  Fin.ofNat 10 ((normalizerWord kind i / 6000) % 10)

def u16ActionIndex (kind : SupportKind) (i : Fin 600) : Fin 10 :=
  Fin.ofNat 10 ((normalizerWord kind i / 60000) % 10)

def blockVertex (block : Fin 3) (position : Fin 5) : Fin 15 :=
  Fin.ofNat 15 (5 * block.val + position.val)

def catalogEdgeIndex (u v : Fin 15) : Nat :=
  let left := min u.val v.val
  let right := max u.val v.val
  left * (29 - left) / 2 + (right - left - 1)

def catalogColor (code : Nat) (u v : Fin 15) : Fin 4 :=
  Fin.ofNat 4 ((code >>> (2 * catalogEdgeIndex u v)) % 4)

/-- Constant-time lookup in the explicit 600-by-105 catalogue table. -/
def catalogMatrixColor (kind : SupportKind) (i : Fin 600)
    (u v : Fin 15) : Fin 4 :=
  let edge := catalogEdgeIndex u v
  let row := ((catalogMatrixByteTable kind)[i.val]?).getD #[]
  let byte := (row[edge / 4]?).getD 0
  Fin.ofNat 4 ((byte >>> (2 * (edge % 4))) % 4)

def blockAction (kind : SupportKind) (a0 a1 a2 : Fin 10)
    (block : Fin 3) (position : Fin 5) : Fin 5 :=
  match block.val with
  | 0 => freeAction a0 position
  | 1 => u15Action kind a1 position
  | _ => u16Action a2 position

def normalizerBlockAction (kind : SupportKind) (i : Fin 600)
    (block : Fin 3) (position : Fin 5) : Fin 5 :=
  blockAction kind (freeActionIndex kind i) (u15ActionIndex kind i)
    (u16ActionIndex kind i) block position

def representativeSet : SupportKind → Finset (Fin 600)
  | .support0 => {0, 20, 21, 25}
  | .support2 => {0, 1, 5, 100}
  | .support7 => {0, 45}

theorem catalogEntryCount : Fintype.card (Fin 600) = 600 := by decide

theorem representativeIndex_mem (kind : SupportKind) (i : Fin 600) :
    representativeIndex kind i ∈ representativeSet kind := by
  cases kind <;> decide +revert

/-- One catalogue entry's complete cross-block normalization obligation. -/
def CatalogNormalizerEquationAt (kind : SupportKind) (i : Fin 600) : Prop :=
  ∀ leftBlock rightBlock : Fin 3, ∀ left right : Fin 5,
    leftBlock < rightBlock →
      catalogMatrixColor kind i
          (blockVertex leftBlock
            (normalizerBlockAction kind i leftBlock left))
          (blockVertex rightBlock
            (normalizerBlockAction kind i rightBlock right)) =
        catalogMatrixColor kind (representativeIndex kind i)
          (blockVertex leftBlock left) (blockVertex rightBlock right)

/-- Six blocks of one hundred indices cover `Fin 600` definitionally. -/
def catalogChunkIndex (chunk : Fin 6) (offset : Fin 100) : Fin 600 :=
  ⟨100 * chunk.val + offset.val, by omega⟩

