import R4333Lean.ProfileDUUUDegreeTenSupportOrbits61

/-!
# Kernel-checked catalogue orbits in the UUU degree-ten branch

For each of the three normalized `U15` support positions, this file records
the complete labelled 600-entry critical-`K15` neighbourhood catalogue.  A
matrix is packed with two bits per edge in lexicographic edge order.  The
packing is only storage: `catalogColor` is the public decoded matrix.

Explicit extendible block actions and one explicit action witness for every
catalogue entry reduce the 600 matrices to the following indices:

* support `0`: `0`, `20`, `21`, `25`;
* support `2`: `0`, `1`, `5`, `100`;
* support `7`: `0`, `45`.

The tables below are theorem data, not imported solver or Python results.
Every orbit equation and every automorphism obligation is proved by ordinary
Lean kernel reduction.
-/

namespace R4333
namespace ProfileDUUUDegreeTenCatalogOrbits61

open ProfileDUUUDegreeTenSupportOrbits61

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

inductive SupportKind where
  | support0
  | support2
  | support7
  deriving DecidableEq

def supportIndex : SupportKind → Fin 11
  | .support0 => 0
  | .support2 => 2
  | .support7 => 7

/-! ## Extendible actions on the three ordered five-blocks -/

/-- The ten automorphisms of the retained free five-cycle. -/
def freeAction : Fin 10 → Fin 5 → Fin 5 :=
  ![![0, 1, 2, 3, 4],
    ![0, 4, 3, 2, 1],
    ![1, 0, 4, 3, 2],
    ![1, 2, 3, 4, 0],
    ![2, 1, 0, 4, 3],
    ![2, 3, 4, 0, 1],
    ![3, 2, 1, 0, 4],
    ![3, 4, 0, 1, 2],
    ![4, 0, 1, 2, 3],
    ![4, 3, 2, 1, 0]]

def u15SupportVertex : SupportKind → Fin 5 → Fin 15
  | .support0 => ![0, 1, 4, 8, 14]
  | .support2 => ![0, 6, 8, 9, 12]
  | .support7 => ![2, 4, 8, 12, 13]

def u16SupportZeroVertex : Fin 5 → Fin 16 := ![0, 1, 4, 8, 14]

/-- Induced support actions of strong `U15` automorphisms.  For support zero
and support two the stabilizer has order two; the remaining eight table rows
repeat those two actions so that all three action parameters have type
`Fin 10`. -/
def u15Action : SupportKind → Fin 10 → Fin 5 → Fin 5
  | .support0 =>
      ![![0, 1, 2, 3, 4], ![4, 1, 3, 2, 0],
        ![0, 1, 2, 3, 4], ![4, 1, 3, 2, 0],
        ![0, 1, 2, 3, 4], ![4, 1, 3, 2, 0],
        ![0, 1, 2, 3, 4], ![4, 1, 3, 2, 0],
        ![0, 1, 2, 3, 4], ![4, 1, 3, 2, 0]]
  | .support2 =>
      ![![0, 1, 2, 3, 4], ![0, 3, 4, 1, 2],
        ![0, 1, 2, 3, 4], ![0, 3, 4, 1, 2],
        ![0, 1, 2, 3, 4], ![0, 3, 4, 1, 2],
        ![0, 1, 2, 3, 4], ![0, 3, 4, 1, 2],
        ![0, 1, 2, 3, 4], ![0, 3, 4, 1, 2]]
  | .support7 =>
      ![![0, 1, 2, 3, 4],
        ![0, 3, 4, 1, 2],
        ![1, 0, 2, 4, 3],
        ![1, 4, 3, 0, 2],
        ![2, 3, 1, 4, 0],
        ![2, 4, 0, 3, 1],
        ![3, 0, 4, 2, 1],
        ![3, 2, 1, 0, 4],
        ![4, 1, 3, 2, 0],
        ![4, 2, 0, 1, 3]]

def u16Action : Fin 10 → Fin 5 → Fin 5 :=
