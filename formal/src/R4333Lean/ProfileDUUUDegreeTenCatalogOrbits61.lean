theorem freeAction_bijective (a : Fin 10) :
    Function.Bijective (freeAction a) := by
  fin_cases a <;> decide

theorem u15StabilizerMap_bijective (kind : SupportKind) (a : Fin 10) :
    Function.Bijective (u15StabilizerMap kind a) := by
  cases kind <;> fin_cases a <;> decide

theorem u15StabilizerMap_preserves
    (kind : SupportKind) (a : Fin 10) (u v : Fin 15) (huv : u ≠ v) :
    k15Template false (u15StabilizerMap kind a u)
        (u15StabilizerMap kind a v) = k15Template false u v := by
  cases kind <;> fin_cases a <;> fin_cases u <;> fin_cases v <;>
    simp_all <;> decide

theorem u15StabilizerMap_induces
    (kind : SupportKind) (a : Fin 10) (p : Fin 5) :
    u15StabilizerMap kind a (u15SupportVertex kind p) =
      u15SupportVertex kind (u15Action kind a p) := by
  cases kind <;> fin_cases a <;> fin_cases p <;> decide

theorem u16StabilizerMap_bijective (a : Fin 10) :
    Function.Bijective (u16StabilizerMap a) := by
  fin_cases a <;> decide

theorem u16StabilizerMap_preserves
    (a : Fin 10) (u v : Fin 16) (huv : u ≠ v) :
    k16Template false (u16StabilizerMap a u) (u16StabilizerMap a v) =
      k16Template false u v := by
  fin_cases a <;> fin_cases u <;> fin_cases v <;> simp_all <;> decide

theorem u16StabilizerMap_induces (a : Fin 10) (p : Fin 5) :
    u16StabilizerMap a (u16SupportZeroVertex p) =
      u16SupportZeroVertex (u16Action a p) := by
  fin_cases a <;> fin_cases p <;> decide

noncomputable def u15StabilizerEquiv
    (kind : SupportKind) (a : Fin 10) : Equiv.Perm (Fin 15) :=
  Equiv.ofBijective (u15StabilizerMap kind a)
    (u15StabilizerMap_bijective kind a)

noncomputable def u16StabilizerEquiv (a : Fin 10) : Equiv.Perm (Fin 16) :=
  Equiv.ofBijective (u16StabilizerMap a) (u16StabilizerMap_bijective a)

noncomputable def u15StrongStabilizer
    (kind : SupportKind) (a : Fin 10) :
    StrongTemplateAutomorphism 15 (k15Template false) where
  vertex := u15StabilizerEquiv kind a
  preserves := by
    intro u v huv
    change k15Template false (u15StabilizerMap kind a u)
      (u15StabilizerMap kind a v) = k15Template false u v
    exact u15StabilizerMap_preserves kind a u v huv

noncomputable def u16StrongStabilizer (a : Fin 10) :
    StrongTemplateAutomorphism 16 (k16Template false) where
  vertex := u16StabilizerEquiv a
  preserves := by
    intro u v huv
    change k16Template false (u16StabilizerMap a u)
      (u16StabilizerMap a v) = k16Template false u v
    exact u16StabilizerMap_preserves a u v huv

