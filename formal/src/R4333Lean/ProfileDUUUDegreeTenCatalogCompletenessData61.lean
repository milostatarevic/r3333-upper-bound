def selectedCompatibleMap (kind : SupportKind) (twisted : Bool)
    (a0 a1 a2 : Fin 10) (block : Fin 3) (position : Fin 5) : Fin 5 :=
  match block.val with
  | 0 => compatibleMap kind twisted 0 a0 position
  | 1 => compatibleMap kind twisted 1 a1 position
  | _ => compatibleMap kind twisted 2 a2 position

def candidateTemplateVertex (kind : SupportKind) (twisted : Bool)
    (a0 a1 a2 : Fin 10) (vertex : Fin 15) : Fin 15 :=
  let block : Fin 3 := Fin.ofNat 3 (vertex.val / 5)
  let position : Fin 5 := Fin.ofNat 5 (vertex.val % 5)
  canonicalPartVertex twisted block
    (selectedCompatibleMap kind twisted a0 a1 a2 block position)

def candidateMatrixColor (kind : SupportKind) (twisted : Bool)
    (a0 a1 a2 : Fin 10) (left right : Fin 15) : Fin 4 :=
  canonicalPalette 1
    (k15Template twisted
      (candidateTemplateVertex kind twisted a0 a1 a2 left)
      (candidateTemplateVertex kind twisted a0 a1 a2 right))

def candidateRank (twisted : Bool) (a0 a1 a2 : Fin 10) : Nat :=
  (if twisted then 1000 else 0) +
    100 * a0.val + 10 * a1.val + a2.val

@[simp] theorem candidateRank_lt
    (twisted : Bool) (a0 a1 a2 : Fin 10) :
    candidateRank twisted a0 a1 a2 < 2000 := by
  cases twisted <;> simp [candidateRank] <;> omega

