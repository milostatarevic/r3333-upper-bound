theorem orbitNormalizerWordTable_size (pair : Fin 9) :
    (orbitNormalizerWordTable pair).size = 600 := by
  fin_cases pair <;> decide

def orbitNormalizerWord (pair : Fin 9) (row : Fin 600) : Nat :=
  ((orbitNormalizerWordTable pair)[row.val]?).getD 0

def representativeIndex (pair : Fin 9) (row : Fin 600) : Fin 600 :=
  Fin.ofNat 600 (orbitNormalizerWord pair row % 600)

def freeActionIndex (pair : Fin 9) (row : Fin 600) : Fin 10 :=
  Fin.ofNat 10 ((orbitNormalizerWord pair row / 600) % 10)

def firstActionIndex (pair : Fin 9) (row : Fin 600) : Fin 10 :=
  Fin.ofNat 10 ((orbitNormalizerWord pair row / 6000) % 10)

def secondActionIndex (pair : Fin 9) (row : Fin 600) : Fin 10 :=
  Fin.ofNat 10 ((orbitNormalizerWord pair row / 60000) % 10)

def actionAt (pair : Fin 9) (row : Fin 600)
    (block : Fin 3) (position : Fin 5) : Fin 5 :=
  match block.val with
  | 0 => freeAction (freeActionIndex pair row) position
  | 1 => alignedFirstAction (pairFirst pair) (firstActionIndex pair row) position
  | _ => alignedSecondAction (pairSecond pair) (secondActionIndex pair row) position

def representativeSet : Fin 9 → Finset (Fin 600)
  | 0 => {0,1,8,12,13,20,24,25,26,27,40,68,75,100,101,113}
  | 1 => {0,1,4,8,9,20,24,25,26,27,32,33,48,100,101,104}
  | 2 => {0,24,25,100}
  | 3 => {0,4,5,20,32,36,37,48,52,53,60,80,81,88,92,93}
  | 4 => {0,4,5,12,13,24,28,36,37,44,64,80,81,84,88,89}
  | 5 => {4,5,24,80}
  | 6 => {0,1,13,45}
  | 7 => {0,1,4,45}
  | _ => {0,45}

private theorem representativeWordTable_checked :
    ∀ pair : Fin 9, (orbitNormalizerWordTable pair).all
      (fun n => decide (Fin.ofNat 600 (n % 600) ∈ representativeSet pair)) := by
  simp only [← Array.all_toList]
  decide

 theorem representativeIndex_mem (pair : Fin 9) (row : Fin 600) :
    representativeIndex pair row ∈ representativeSet pair := by
  have hb : row.val < (orbitNormalizerWordTable pair).size := by
    rw [orbitNormalizerWordTable_size]
    exact row.isLt
  have hm : (orbitNormalizerWordTable pair)[row.val] ∈ orbitNormalizerWordTable pair :=
    Array.mem_of_getElem rfl
  have h := (Array.all_eq_true_iff_forall_mem.mp
    (representativeWordTable_checked pair)) _ hm
  have hc := of_decide_eq_true h
  simpa [representativeIndex, orbitNormalizerWord, hb] using hc

def NormalizerEquationAt (pair : Fin 9) (row : Fin 600) : Prop :=
  ∀ leftBlock rightBlock : Fin 3, leftBlock < rightBlock →
    ∀ left right : Fin 5,
      catalogMatrixColor (catalogSupportKind (pairFirst pair)) row
          (blockVertex leftBlock (actionAt pair row leftBlock left))
          (blockVertex rightBlock (actionAt pair row rightBlock right)) =
        catalogMatrixColor (catalogSupportKind (pairFirst pair))
          (representativeIndex pair row)
          (blockVertex leftBlock left) (blockVertex rightBlock right)

#print axioms orbitNormalizerWordTable_size
#print axioms alignedFirstAction_bijective
#print axioms representativeIndex_mem

