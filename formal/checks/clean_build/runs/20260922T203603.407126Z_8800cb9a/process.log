PricingC.NativeActionPhysical.physical_edge_transport {V C : Type} (f : Fin 27280)
  (hf : PricingC.NativeActionFactors.Valid f) (free : ℕ → V)
  (l :
    Fin
        (PricingC.NativeBlockAutomorphisms.order
          (PricingC.NativeBlockActions.kind (PricingC.NativeActionFactors.left f))) ↪
      V)
  (r :
    Fin
        (PricingC.NativeBlockAutomorphisms.order
          (PricingC.NativeBlockActions.kind (PricingC.NativeActionFactors.right f))) ↪
      V)
  (host : V → V → C) (a b : Fin 15) (ha : ↑a < PricingC.NativeActionFactors.count f)
  (hb : ↑b < PricingC.NativeActionFactors.count f) :
  host (PricingC.NativeActionPhysical.after f free l r ↑a) (PricingC.NativeActionPhysical.after f free l r ↑b) =
    host
      (PricingC.NativeActionPhysical.before f free l r
        (PricingC.NativeBlockActions.digit (PricingC.NativeActionFactors.coordinateCode f) ↑a))
      (PricingC.NativeActionPhysical.before f free l r
        (PricingC.NativeBlockActions.digit (PricingC.NativeActionFactors.coordinateCode f) ↑b))
'PricingC.NativeActionPhysical.physical_edge_transport' depends on axioms: [propext, Classical.choice, Quot.sound]
