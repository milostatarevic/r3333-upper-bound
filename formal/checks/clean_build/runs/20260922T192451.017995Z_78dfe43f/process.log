PricingABD.Rooted455Entrance.rooted_isomorphism_cover (c : EdgeColoring (Fin 15) ThreeColor)
  (hc : NoMonochromaticTriangle c) (h : CanonicalRooted455 c) :
  ∃ r e a b d,
    e (rootVertex r) = 14 ∧
      (∀ (u v : Fin 15), u ≠ v → c.color (e u) (e v) = (k15Template (rootTwisted r)).color u v) ∧
        (∀ (i : Fin 4), e.symm (label0 i) = iso0 r a i) ∧
          (∀ (i : Fin 5), e.symm (label1 i) = iso1 r b i) ∧ ∀ (i : Fin 5), e.symm (label2 i) = iso2 r d i
